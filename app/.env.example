# Supabase — create project at supabase.com, copy from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EIA API — free registration at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your-eia-api-key

# Transactional email — Resend (https://resend.com) or Postmark
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=alerts@yourdomain.com

# WhatsApp Cloud API — Meta for Developers > Business Account
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Cron security — random secret to protect cron trigger endpoints
CRON_SECRET=your-random-cron-secret

# App URL
NEXT_PUBLIC_APP_URL=https://yourdomain.com
